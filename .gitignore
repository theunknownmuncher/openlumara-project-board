# project-board: openlumara loads this module straight from source, and the tests
# run from the repository root, so most of what shows up here is cache the tooling
# leaves behind plus the scratch a live test install generates.

# --- python bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- virtualenvs and tooling caches ---
.venv/
venv/

# --- test / lint / typing caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- browser checks: screenshots and any throwaway playwright scratch ---
shots/
screenshots/
playwright-runtime/
node_modules/
package.json
package-lock.json

# --- a throwaway install pointed inside the repo while testing. real board data
#     lives in openlumara's own data folder, never here ---
/data/
*.local.yml
.env

# --- packaging, if this ever gets built ---
build/
dist/
sdist/
wheels/
*.egg-info/

# --- editors / ides ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- os cruft ---
.DS_Store
._*
Thumbs.db
desktop.ini

# --- logs ---
*.log
